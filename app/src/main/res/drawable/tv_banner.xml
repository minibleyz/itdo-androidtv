<?xml version="1.0" encoding="utf-8"?>
<!-- Простой баннер 320x180 для лаунчера Android TV: тёмный фон + надпись ITDO акцентным цветом. Можно заменить на PNG позже -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22190F" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="#D68A4C" />
        </shape>
    </item>
</layer-list>
